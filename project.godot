[rendering]

; 1 = NEAREST。键名于 2026-10-04 实测确认(原 modules/display-2d.md 标为 NOT SOURCEABLE)。
textures/canvas_textures/default_texture_filter=1

renderer/rendering_method="forward_plus"
; 美术规格.md §2 --ink-deep:场景外与未绘制区域的底色。
; 不设的话 Godot 用默认灰,矮场景(如坑底)会露出来。
environment/defaults/default_clear_color=Color(0.0431373, 0.0705882, 0.12549, 1)
